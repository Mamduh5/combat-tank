# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Runtime / tooling caches
.cache/
.vite/
coverage/

# Local environment
.env
.env.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local simulation artifacts (replays, logs, headless run output)
*.ctreplay
logs/

# Visual-review artifacts (tools/shot.mjs output and the headless browser profiles)
shots/
# One profile per browser harness, so two harnesses can run at once without colliding on a locked
# `SingletonLock`. `tools/control-check.mjs` adds `.chrome-profile-controls`.
.chrome-profile*/

# Local dev-server and verification logs. These are written by vite preview and by
# the ad-hoc verification runs; none of them are project artefacts.
preview.log
*.log
