{
  "name": "combat-tank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Combat Tank — a 3D tactical tank-combat game for PC.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node tools/build-assets.mjs",
    "assets:check": "node tools/build-assets.mjs --check",
    "assets:audit": "node tools/audit-assets.mjs",
    "sim": "node tools/sim.mjs",
    "routes": "node tools/measure-routes.mjs",
    "contact": "node tools/measure-contact.mjs",
    "grounding": "node tools/measure-grounding.mjs",
    "grounding-shots": "node tools/grounding-shots.mjs",
    "shots": "node tools/shots.mjs",
    "controls": "node tools/control-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "verify:browser": "npm run build && npm run assets:audit",
    "runtime": "npm run build && node tools/runtime-check.mjs shots/runtime",
    "runtime:quick": "npm run build && node tools/runtime-check.mjs shots/runtime-quick --runtime-ms=15000",
    "audio:analyse": "node tools/audio-analysis.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@babylonjs/loaders": "9.29.0",
    "@dimforge/rapier3d-compat": "^0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
